export GPG_TTY=$(tty)
export PATH="$HOME/.npm-global/bin:$HOME/.local/bin:/usr/local/sbin:$PATH"
if [ -s "$HOME/.nvm/nvm.sh" ]; then
	source "$HOME/.nvm/nvm.sh"
fi
