{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "chief-of-staff",
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "deny" },
    // Shell bypasses external_directory; deny it and allow only read-only
    // inspection and pure-output commands. Prefix rules must never cover a
    // subcommand that can write or execute.
    { "action": "shell", "resource": "*", "effect": "deny" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git blame *", "effect": "allow" },
    { "action": "shell", "resource": "git describe *", "effect": "allow" },
    // Pure output and metadata: no file writes, no execution, no network.
    { "action": "shell", "resource": "echo *", "effect": "allow" },
    { "action": "shell", "resource": "printf *", "effect": "allow" },
    { "action": "shell", "resource": "pwd", "effect": "allow" },
    { "action": "shell", "resource": "date *", "effect": "allow" },
    { "action": "shell", "resource": "whoami", "effect": "allow" },
    { "action": "shell", "resource": "id *", "effect": "allow" },
    { "action": "shell", "resource": "groups *", "effect": "allow" },
    { "action": "shell", "resource": "uname *", "effect": "allow" },
    { "action": "shell", "resource": "hostname", "effect": "allow" },
    { "action": "shell", "resource": "which *", "effect": "allow" },
    { "action": "shell", "resource": "type *", "effect": "allow" },
    { "action": "shell", "resource": "command -v *", "effect": "allow" },
    { "action": "shell", "resource": "true", "effect": "allow" },
    { "action": "shell", "resource": "false", "effect": "allow" },
    { "action": "shell", "resource": "test *", "effect": "allow" },
    { "action": "shell", "resource": "basename *", "effect": "allow" },
    { "action": "shell", "resource": "dirname *", "effect": "allow" },
    { "action": "shell", "resource": "realpath *", "effect": "allow" },
    { "action": "shell", "resource": "readlink *", "effect": "allow" },
    { "action": "shell", "resource": "sleep *", "effect": "allow" },
    { "action": "shell", "resource": "seq *", "effect": "allow" },
    // Read-only file inspection. Shell is not constrained by
    // external_directory, so the container filesystem is the path boundary.
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "stat *", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "grep *", "effect": "allow" },
    { "action": "shell", "resource": "find *", "effect": "allow" },
    { "action": "shell", "resource": "du *", "effect": "allow" },
    { "action": "shell", "resource": "diff *", "effect": "allow" },
    { "action": "shell", "resource": "cmp *", "effect": "allow" },
    { "action": "shell", "resource": "jq *", "effect": "allow" },
    { "action": "shell", "resource": "sha256sum *", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "ask" },
    { "action": "websearch", "resource": "*", "effect": "ask" }
  ],
  "plugins": ["/opt/vault-guard"],
  "agents": {
    "chief-of-staff": {
      "description": "Ted's management consultant and chief of staff for the Apify vault",
      "mode": "primary",
      "system": "{file:SYSTEM_PROMPT.md}"
    }
  },
  "mcp": {
    "servers": {
      // OAuth callback port 4098: compose publishes 4098->4099 and
      // vault/entrypoint.sh bridges 4099->4098. Keep all three in sync.
      "notion": {
        "type": "remote",
        "url": "https://mcp.notion.com/mcp",
        "oauth": {
          "callback_port": 4098
        }
      },
      "slack": {
        "type": "local",
        "command": ["/usr/local/bin/slack-mcp-server", "-no-cache", "--transport", "stdio"],
        "environment": {
          "SLACK_MCP_XOXC_TOKEN": "{env:SLACK_MCP_XOXC_TOKEN}",
          "SLACK_MCP_XOXD_TOKEN": "{env:SLACK_MCP_XOXD_TOKEN}",
          "SLACK_MCP_ENABLED_TOOLS": "channels_list,conversations_history,conversations_replies,conversations_search_messages,conversations_unreads,users_search,usergroups_list"
        }
      },
      "apify": {
        "type": "remote",
        "url": "https://mcp.apify.com/",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:APIFY_TOKEN}"
        }
      },
      "miro": {
        "type": "remote",
        "url": "https://mcp.miro.com/",
        "oauth": {
          "callback_port": 4098,
          "scope": "boards:read"
        }
      },
      "google-calendar": {
        "type": "local",
        "command": ["node", "/app/google-calendar-server.mjs"],
        "environment": {
          "GCAL_APPS_SCRIPT_URL": "{env:GCAL_APPS_SCRIPT_URL}",
          "GCAL_ACCESS_KEY": "{env:GCAL_ACCESS_KEY}"
        }
      }
    }
  },
  "providers": {
    "ollama-cloud-shortlist": {
      "name": "Ollama Cloud",
      "canonical": "ollama-cloud",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://ollama.com/v1",
        "apiKey": "{env:OLLAMA_API_KEY}"
      },
      "models": {
        "deepseek-v4.1-flash": { "settings": { "reasoningEffort": "max" } },
        "kimi-k3": { "settings": { "reasoningEffort": "max" } },
        "glm-5.3": { "settings": { "reasoningEffort": "max" } },
        "glm-5.3-flash": { "settings": { "reasoningEffort": "max" } },
        "minimax-m3.1-flash": { "settings": { "reasoningEffort": "max" } }
      }
    },
    "openrouter-shortlist": {
      "name": "OpenRouter",
      "canonical": "openrouter",
      "package": "@opencode/ai/providers/openrouter",
      "env": ["OPENROUTER_API_KEY"],
      "models": {
        "openai/gpt-6.1-sol": {},
        "anthropic/claude-opus-5.5": {}
      }
    }
  },
  "policies": [
    { "action": "provider.use", "resource": "*", "effect": "deny" },
    { "action": "provider.use", "resource": "ollama-cloud-shortlist", "effect": "allow" },
    { "action": "provider.use", "resource": "openrouter-shortlist", "effect": "allow" }
  ]
}
