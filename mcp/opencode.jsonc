{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "chief-of-staff",
  "agents": {
    "chief-of-staff": {
      "description": "Ted's management consultant and chief of staff for the Apify vault",
      "mode": "primary",
      "system": "{file:SYSTEM_PROMPT.md}",
      "permissions": [
        { "action": "external_directory", "resource": "*", "effect": "deny" }
      ]
    }
  },
  "mcp": {
    "servers": {
      "notion": {
        "type": "remote",
        "url": "https://mcp.notion.com/mcp",
        "oauth": {
          "callback_port": 4098
        }
      },
      "slack": {
        "type": "local",
        "command": ["/usr/local/bin/slack-mcp-server", "-no-cache", "--transport", "stdio"],
        "environment": {
          "SLACK_MCP_XOXC_TOKEN": "{env:SLACK_MCP_XOXC_TOKEN}",
          "SLACK_MCP_XOXD_TOKEN": "{env:SLACK_MCP_XOXD_TOKEN}",
          "SLACK_MCP_ENABLED_TOOLS": "channels_list,conversations_history,conversations_replies,conversations_search_messages,conversations_unreads,users_search,usergroups_list"
        }
      },
      "apify": {
        "type": "remote",
        "url": "https://mcp.apify.com/",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:APIFY_TOKEN}"
        }
      },
      "miro": {
        "type": "remote",
        "url": "https://mcp.miro.com/",
        "oauth": {
          "callback_port": 4098,
          "scope": "boards:read"
        }
      }
    }
  },
  "providers": {
    "ollama-cloud": {
      "settings": {
        "apiKey": "{env:OLLAMA_API_KEY}"
      },
      "models": {
        "deepseek-v4.1-flash": { "settings": { "reasoningEffort": "high" } },
        "kimi-k3": { "settings": { "reasoningEffort": "high" } },
        "kimi-k2.7-code": { "settings": { "reasoningEffort": "high" } },
        "glm-5.3": { "settings": { "reasoningEffort": "high" } }
      }
    }
  }
}
