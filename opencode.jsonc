{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama-cloud": {
      "options": {
        "apiKey": "{env:OLLAMA_CLOUD_TOKEN}"
      },
      "models": {
        "kimi-k3": { "options": { "reasoningEffort": "high" } },
        "kimi-k2.7-code": { "options": { "reasoningEffort": "high" } },
        "glm-5.3": { "options": { "reasoningEffort": "high" } },
        "deepseek-v4.1-flash": { "options": { "reasoningEffort": "high" } }
      }
    },
    "openrouter": {
      "models": {
        "deepseek/deepseek-v4-pro": {
          "options": {
            "provider": {
              "order": [ "deepseek" ], 
              "allow_fallbacks": false
            }
          }
        },
        "deepseek/deepseek-v4-flash": {
          "options": {
            "provider": {
              "order": [ "deepseek", "atlas-cloud", "alibaba" ], 
              "allow_fallbacks": true
            }
          }
        },
        "xiaomi/mimo-v2.5-pro": {
          "options": {
            "provider": {
              "order": [ "xiaomi" ], 
              "allow_fallbacks": false
            }
          }
        },
        "xiaomi/mimo-v2.5": {
          "options": {
            "provider": {
              "order": [ "xiaomi" ], 
              "allow_fallbacks": false
            }
          }
        },
        "moonshotai/kimi-k2.6": {
          "options": {
            "provider": {
              "order": [ "wandb", "nebius", "akashml" ], 
              "allow_fallbacks": true
            }
          }
        },
        "z-ai/glm-5.1": {
          "options": {
            "provider": {
              "order": [ "friendli", "fireworks" ], 
              "allow_fallbacks": true
            }
          }
        },
        "google/gemini-3-flash-preview": {
          "options": {
            "provider": {
              "order": [ "google-ai-studio", "google-vertex" ], 
              "allow_fallbacks": true
            }
          }
        },
        "google/gemini-3.1-pro-preview": {
          "options": {
            "provider": {
              "order": [ "google-ai-studio", "google-vertex" ], 
              "allow_fallbacks": true
            }
          }
        },
        "anthropic/claude-opus-4.7": {
          "options": {
            "provider": {
              "order": [ "anthropic", "amazon-bedrock", "google-vertex" ], 
              "allow_fallbacks": true
            }
          }
        },
        "google/claude-sonnet-4.6": {
          "options": {
            "provider": {
              "order": [ "anthropic", "amazon-bedrock", "google-vertex" ], 
              "allow_fallbacks": true
            }
          }
        },
        "google/claude-haiku-4.5": {
          "options": {
            "provider": {
              "order": [ "anthropic", "amazon-bedrock", "google-vertex" ], 
              "allow_fallbacks": true
            }
          }
        }
      }
    }
  },
  "plugin": ["/opt/ponytail/.opencode/plugins/ponytail.mjs"]
}
